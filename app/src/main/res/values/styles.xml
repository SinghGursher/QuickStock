<?xml version="1.0" encoding="utf-8"?>

<resources>

    <!-- =================================================
         TEXT INPUTS
         ================================================= -->

    <style
        name="Widget.QuickStock.TextInputLayout.Outlined"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="boxBackgroundColor">@color/app_surface</item>

        <item name="boxStrokeColor">
            @color/quickstock_input_stroke_color
        </item>

        <item name="hintTextColor">
            @color/quickstock_input_label_color
        </item>

        <item name="android:textColorHint">
            @color/quickstock_input_label_color
        </item>

        <item name="startIconTint">
            @color/quickstock_input_label_color
        </item>

        <item name="endIconTint">
            @color/quickstock_input_label_color
        </item>

        <item name="helperTextTextColor">
            @color/text_secondary
        </item>

        <item name="prefixTextColor">
            @color/text_secondary
        </item>

        <item name="suffixTextColor">
            @color/text_secondary
        </item>

        <item name="errorTextColor">
            @color/error
        </item>

        <item name="errorIconTint">
            @color/error
        </item>

        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>

        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>

    </style>

    <!-- Authentication inputs use slightly softer corners
     while retaining the standard QuickStock input states. -->

    <style
        name="Widget.QuickStock.TextInputLayout.Auth"
        parent="Widget.QuickStock.TextInputLayout.Outlined">

        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>

    </style>

    <style
        name="Widget.QuickStock.TextInputEditText"
        parent="Widget.Material3.TextInputEditText.OutlinedBox">

        <item name="android:textColor">
            @color/text_primary
        </item>

        <item name="android:textColorHint">
            @color/text_secondary
        </item>

        <item name="android:textSize">16sp</item>

    </style>


    <!-- =================================================
         BUTTONS
         ================================================= -->

    <style
        name="Widget.QuickStock.Button.Primary"
        parent="Widget.Material3.Button">

        <item name="backgroundTint">
            @color/quickstock_primary_button_background
        </item>

        <item name="android:textColor">
            @color/quickstock_primary_button_text
        </item>

        <item name="iconTint">
            @color/quickstock_primary_button_text
        </item>

        <item name="rippleColor">
            @color/brand_primary_container
        </item>

        <item name="cornerRadius">14dp</item>

        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>

        <item name="android:textAllCaps">false</item>

    </style>


    <style
        name="Widget.QuickStock.Button.Outlined"
        parent="Widget.Material3.Button.OutlinedButton">

        <item name="backgroundTint">
            @android:color/transparent
        </item>

        <item name="android:textColor">
            @color/quickstock_outlined_button_color
        </item>

        <item name="iconTint">
            @color/quickstock_outlined_button_color
        </item>

        <item name="strokeColor">
            @color/quickstock_outlined_button_color
        </item>

        <item name="strokeWidth">1dp</item>

        <item name="rippleColor">
            @color/brand_primary_container
        </item>

        <item name="cornerRadius">14dp</item>

        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>

        <item name="android:textAllCaps">false</item>

    </style>


    <style
        name="Widget.QuickStock.Button.Text"
        parent="Widget.Material3.Button.TextButton">

        <item name="android:textColor">
            @color/quickstock_outlined_button_color
        </item>

        <item name="iconTint">
            @color/quickstock_outlined_button_color
        </item>

        <item name="rippleColor">
            @color/brand_primary_container
        </item>

        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>

    </style>


    <!-- =================================================
         CARDS
         ================================================= -->

    <style
        name="Widget.QuickStock.Card"
        parent="Widget.Material3.CardView.Elevated">

        <item name="cardBackgroundColor">
            @color/app_surface
        </item>

        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">2dp</item>

    </style>


    <style
        name="Widget.QuickStock.Card.Outlined"
        parent="Widget.Material3.CardView.Outlined">

        <item name="cardBackgroundColor">
            @color/app_surface
        </item>

        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>

        <item name="strokeColor">
            @color/outline_variant
        </item>

        <item name="strokeWidth">1dp</item>

    </style>


    <!-- =================================================
         BOTTOM NAVIGATION
         ================================================= -->

    <style
        name="Widget.QuickStock.BottomNavigation"
        parent="Widget.Material3.BottomNavigationView">

        <item name="android:background">
            @color/app_surface
        </item>

        <item name="itemIconTint">
            @color/quickstock_bottom_nav_item_color
        </item>

        <item name="itemTextColor">
            @color/quickstock_bottom_nav_item_color
        </item>

        <item name="itemRippleColor">
            @color/brand_primary_container
        </item>

        <item name="itemActiveIndicatorStyle">
            @style/Widget.QuickStock.BottomNavigation.ActiveIndicator
        </item>

        <item name="android:elevation">0dp</item>

    </style>

    <style
        name="Widget.QuickStock.BottomNavigation.ActiveIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">

        <item name="android:color">
            @color/brand_primary_container
        </item>

    </style>


    <!-- =================================================
         TYPOGRAPHY
         ================================================= -->

    <style
        name="TextAppearance.QuickStock.ScreenTitle"
        parent="TextAppearance.Material3.HeadlineMedium">

        <item name="android:textColor">
            @color/text_primary
        </item>

        <item name="android:textStyle">bold</item>

    </style>


    <style
        name="TextAppearance.QuickStock.SectionTitle"
        parent="TextAppearance.Material3.TitleLarge">

        <item name="android:textColor">
            @color/text_primary
        </item>

        <item name="android:textStyle">bold</item>

    </style>


    <style
        name="TextAppearance.QuickStock.Body"
        parent="TextAppearance.Material3.BodyMedium">

        <item name="android:textColor">
            @color/text_primary
        </item>

    </style>


    <style
        name="TextAppearance.QuickStock.Body.Secondary"
        parent="TextAppearance.Material3.BodyMedium">

        <item name="android:textColor">
            @color/text_secondary
        </item>

    </style>

</resources>